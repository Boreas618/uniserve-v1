+     * default of read and write access applies. */
     int
-    memReg(void *addr, size_t size, nixlUcxMem &mem, nixl_mem_t nixl_mem_type);
+    memReg(void *addr,
+           size_t size,
+           nixlUcxMem &mem,
+           nixl_mem_t nixl_mem_type,
+           bool read_only = false);
     [[nodiscard]] std::string
     packRkey(nixlUcxMem &mem);

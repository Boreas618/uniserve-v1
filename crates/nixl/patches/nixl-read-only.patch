--- a/src/plugins/ucx/ucx_utils.h	2026-10-28 05:59:37.309079341 +0000
+++ b/src/plugins/ucx/ucx_utils.h	2026-10-28 05:59:37.311079343 +0000
@@ -185,8 +185,16 @@
     }
 
     /* Memory management */
+    /* Registers `size` bytes at `addr`. With `read_only`, the memory is

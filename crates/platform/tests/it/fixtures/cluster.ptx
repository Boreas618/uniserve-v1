// The kernel of the cluster launch test, loaded only on a device that
// launches clusters (`CU_DEVICE_ATTRIBUTE_CLUSTER_LAUNCH`). It reads the
// cluster special registers, which the PTX ISA admits from sm_90 on, the
// oldest architecture it targets.
//
// `report_cluster` writes, for each block, its two grid coordinates, its two
// coordinates inside its cluster, its rank inside the cluster, the cluster's
// two dimensions and the thread's x index, eight 32-bit words per block; only
// thread 0 of a block stores.
.version 8.0
.target sm_90
.address_size 64

.visible .entry report_cluster(.param .u64 out)
{
    .reg .u64 %rd<3>;
    .reg .u32 %r<11>;
    .reg .pred %p;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    mov.u32 %r3, %cluster_ctaid.x;
    mov.u32 %r4, %cluster_ctaid.y;
    mov.u32 %r5, %cluster_ctarank;
    mov.u32 %r6, %cluster_nctaid.x;
    mov.u32 %r7, %cluster_nctaid.y;
    mov.u32 %r8, %nctaid.x;
    mov.u32 %r9, %tid.x;
    mad.lo.u32 %r10, %r8, %r2, %r1;
    mul.wide.u32 %rd2, %r10, 32;
    add.u64 %rd2, %rd1, %rd2;
    setp.eq.u32 %p, %r9, 0;
    @%p st.global.u32 [%rd2], %r1;
    add.u64 %rd2, %rd2, 4;
    @%p st.global.u32 [%rd2], %r2;
    add.u64 %rd2, %rd2, 4;
    @%p st.global.u32 [%rd2], %r3;
    add.u64 %rd2, %rd2, 4;
    @%p st.global.u32 [%rd2], %r4;
    add.u64 %rd2, %rd2, 4;
    @%p st.global.u32 [%rd2], %r5;
    add.u64 %rd2, %rd2, 4;
    @%p st.global.u32 [%rd2], %r6;
    add.u64 %rd2, %rd2, 4;
    @%p st.global.u32 [%rd2], %r7;
    add.u64 %rd2, %rd2, 4;
    @%p st.global.u32 [%rd2], %r9;
    ret;
}

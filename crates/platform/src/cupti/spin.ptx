// The kernel of the CUPTI device tests: every thread counts to its second
// parameter and stores the count through its first. The driver compiles it for
// the device it is loaded on; it targets the oldest architecture the PTX ISA
// version admits, so it loads on every device the crate drives.
.version 8.0
.target sm_50
.address_size 64

.visible .entry spin(.param .u64 out, .param .u32 n)
{
    .reg .u64 %rd<2>;
    .reg .u32 %r<3>;
    .reg .pred %p;
    ld.param.u64 %rd1, [out];
    ld.param.u32 %r1, [n];
    mov.u32 %r2, 0;
LOOP:
    add.u32 %r2, %r2, 1;
    setp.lt.u32 %p, %r2, %r1;
    @%p bra LOOP;
    st.global.u32 [%rd1], %r2;
    ret;
}
